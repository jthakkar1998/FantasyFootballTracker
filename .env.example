# Your league is pre-filled in lib/config.ts, but these let you change seasons later.
ESPN_LEAGUE_ID=666066604
ESPN_SEASON=2026
LEAGUE_TIME_ZONE=America/Chicago

# Server-side Supabase access. Keep the secret key private.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Safe browser-side Supabase values used only for signed video uploads.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Pick a password only you know. Do not commit it to Git.
ADMIN_PASSWORD=replace-with-a-strong-commissioner-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# Used by Vercel to authenticate the daily sync job.
CRON_SECRET=replace-with-another-long-random-string

# Free SportsGameOdds API key used server-side for FanDuel NFL player props.
# Keep this private; never prefix it with NEXT_PUBLIC_.
SPORTSGAMEODDS_API_KEY=replace-with-your-free-api-key

# Web Push keys. Generate with the script in PARLAY-REMINDERS-SETUP.md.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace-with-65-byte-p256-public-key-base64url
VAPID_PRIVATE_KEY=replace-with-32-byte-p256-private-key-base64url
VAPID_SUBJECT=mailto:your-email@example.com

# Optional: link for the $1 Venmo popup; leave blank to just show the reminder.
# Example: https://venmo.com/u/YourActualVenmoUsername
NEXT_PUBLIC_VENMO_URL=
